  "private": true,
  "scripts": {
    "dev": "npm --prefix \"FULL UI DESIGN\" run dev -- -H 0.0.0.0",
    "dev:https": "npm --prefix \"FULL UI DESIGN\" run dev -- --experimental-https -H 0.0.0.0",
